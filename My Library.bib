@article{chauvin_crossover_2007,
	title = {Crossover from Josephson to Multiple Andreev Reflection Currents in Atomic Contacts},
	volume = {99},
	url = {https://link.aps.org/doi/10.1103/PhysRevLett.99.067008},
	doi = {10.1103/PhysRevLett.99.067008},
	abstract = {The basic current-carrying mechanism through a superconducting weak link embedded in a resistive environment undergoes a continuous crossover, as the voltage increases, from Josephson Cooper pair transfer exciting electromagnetic modes in the environment to multiple Andreev reflections leading to the creation of quasiparticles. We corroborate these ideas through measurements of the dc current-voltage characteristics of superconducting atomic contacts containing channels of arbitrary and adjustable transmission. We present a simple model, in the spirit of the classical resistively shunted junction model, that accounts well for the observed characteristics.},
	pages = {067008},
	number = {6},
	journaltitle = {Physical Review Letters},
	shortjournal = {Phys. Rev. Lett.},
	publisher = {American Physical Society},
	author = {Chauvin, M. and vom Stein, P. and Esteve, D. and Urbina, C. and Cuevas, J. C. and Yeyati, A. Levy},
	urldate = {2025-03-13},
