	file = {APS Snapshot:/Users/oliver/Documents/zotero/storage/4MJHX5BH/RevModPhys.57.html:text/html;Full Text PDF:/Users/oliver/Documents/zotero/storage/YAE4J4XB/Tucker and Feldman - 1985 - Quantum detection at millimeter wavelengths.pdf:application/pdf},
}

