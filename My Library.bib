	file = {APS Snapshot:/Users/oliver/Documents/zotero/storage/223VUG9Y/PhysRevLett.121.html:text/html;Full Text PDF:/Users/oliver/Documents/zotero/storage/UMGC5BY8/Snyder et al. - 2018 - Weak-link Josephson Junctions Made from Topological Crystalline Insulators.pdf:application/pdf},
}

@thesis{bloch_interplay_2024,
