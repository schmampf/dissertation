	author = {Krupenin, V A and Zorin, A B and Presnov, D E and Savvateev, M N and Niemeyer, J},
	urldate = {2025-03-13},
	date = {2001-10-01},
	langid = {english},
	file = {PDF:/Users/oliver/Documents/zotero/storage/A4HGN4ZG/Krupenin et al. - 2001 - Metallic single-electron transistor without traditional tunnel barriers.pdf:application/pdf},
