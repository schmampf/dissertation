@article{octavio_subharmonic_1983,
	title = {Subharmonic energy-gap structure in superconducting constrictions},
	volume = {27},
	url = {https://link.aps.org/doi/10.1103/PhysRevB.27.6739},
	doi = {10.1103/PhysRevB.27.6739},
	abstract = {A Boltzmann-equation approach for the calculation of the 𝐼 −𝑉 characteristics of superconducting constrictions is presented. This technique allows for the inclusion of normal scattering as well as Andreev reflection processes in the constriction. The computed 𝐼 −𝑉 characteristics exhibit subharmonic gap structure which varies strongly with scattering strength and temperature. For even small scattering strengths, the structure is found to persist to 𝑇 =0, and its temperature dependence agrees qualitatively with experimental observations. In the limit of zero scattering, the technique is shown to be equivalent to the trajectory technique of Klapwijk, Blonder, and Tinkham.},
	pages = {6739--6746},
	number = {11},
	journaltitle = {Physical Review B},
